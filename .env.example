# OracleDesk backend configuration. Copy to .env and fill in what you need.
# Every value here is empty or a local default. Never commit a filled-in .env.
# Variables are validated at startup (src/config/index.ts); a bad value stops
# the server with a message naming the variable.

# ── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
# Postgres and Redis. These defaults match docker-compose.yml (local only,
# not secrets). Point them at your own servers for anything shared.
DATABASE_URL=postgresql://oracledesk:oracledesk@127.0.0.1:5433/oracledesk
# Alternatively, mount the URL from a file: DATABASE_URL_FILE=/run/secrets/database_url
# Every secret below also accepts <NAME>_FILE (env/file provider) — see #145.

# ── Secret loading (#145) ──────────────────────────────────────────────────
# env: process environment (default); file: <NAME>_FILE mounts; vault: Vault KV v2.
SECRETS_PROVIDER=env
# Refresh interval for file/vault providers (minimum 30000 ms).
SECRETS_REFRESH_MS=300000
# How long a rotated JWT_SECRET remains valid for already-issued tokens.
JWT_PREVIOUS_SECRET_GRACE_SECS=86400
# Required only when SECRETS_PROVIDER=vault.
VAULT_ADDR=
VAULT_TOKEN_FILE=
VAULT_KV_PATH=
REDIS_URL=redis://127.0.0.1:6379
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ── Auth ───────────────────────────────────────────────────────────────────
# JWT signing secret, at least 32 characters. Required in production. If
# empty in development, a random one is generated per process.
JWT_SECRET=
# Stellar secret seed (S…) that signs SEP-10 login challenges. Use a fresh
# key that holds no funds and is not the agent key. Required in production;
# generated per process in development if empty.
AUTH_SIGNING_SECRET=
# Domain shown in the challenge transaction (the frontend's host).
AUTH_HOME_DOMAIN=localhost
AUTH_WEB_AUTH_DOMAIN=
# Comma-separated G… addresses allowed to call admin endpoints.
ADMIN_ADDRESSES=

# ── Stellar network ────────────────────────────────────────────────────────
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Contract ids. Empty means "use src/generated/deployments.testnet.json".
MARKET_CORE_CONTRACT_ID=
TREASURY_CONTRACT_ID=
RESOLVER_CONTRACT_ID=
REASONING_REGISTRY_CONTRACT_ID=
USDC_CONTRACT_ID=

# Recipient of premium (daily pass) payments, G… or C…. Empty means the
# treasury contract, which makes subscription revenue agent trading capital.
# That is a product decision; see docs/STATUS.md.
PAYMENTS_RECIPIENT=
# Daily pass price in 7-decimal USDC base units (5000000 = 0.50 USDC).
DAILY_PASS_PRICE_RAW=5000000

# ── Agent execution ────────────────────────────────────────────────────────
# dry-run (default): every write is built and simulated, never signed or sent.
# live: writes are signed with AGENT_SECRET_KEY and submitted. Testnet only;
# the server refuses live mode on any other network.
CHAIN_EXECUTION_MODE=dry-run
# WARNING: testnet only. The agent's secret seed (S…). It controls treasury
# trades up to the treasury's caps. Never put a mainnet key here.
AGENT_SECRET_KEY=

# Resolution spec committed at market creation (signer mode). Empty signers
# means the agent account is the only signer.
RESOLUTION_SIGNERS=
RESOLUTION_THRESHOLD=1
RESOLUTION_DISPUTE_WINDOW_SECS=86400

# Accept a well-formed inbound X-Request-Id; set false without a trusted proxy.
TRUST_INBOUND_REQUEST_ID=true

# Event indexer (Stellar RPC getEvents poller).
INDEXER_ENABLED=true
INDEXER_POLL_MS=5000

# Health probes (#111): /livez (process only) and /readyz (dependencies).
# HEALTH_CRITICAL: comma list of database,redis,rpc,indexer that fail readiness.
HEALTH_CRITICAL=database,redis
HEALTH_PROBE_TIMEOUT_MS=1500
HEALTH_CACHE_TTL_MS=2000
INDEXER_MAX_LAG_LEDGERS=120
INDEXER_MAX_STALENESS_MS=60000
LIVENESS_MAX_LOOP_DELAY_MS=2000
# Drain + close must fit the 15 s forced-exit window.
SHUTDOWN_DRAIN_MS=5000

# ── LLM providers (market and trace generation) ────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── IPFS (Pinata) ──────────────────────────────────────────────────────────
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
# pinata (default) or local (development only; stores bytes in .ipfs-local/).
IPFS_TRANSPORT=pinata
IPFS_LOCAL_DIR=.ipfs-local

# ── Data sources ───────────────────────────────────────────────────────────
NEWSAPI_KEY=
FRED_API_KEY=

# ── Calibration (#68) ──────────────────────────────────────────────────────
# Slices with fewer resolved markets return insufficientData.
MIN_CALIBRATION_MARKETS=20
# time | last | first: how a market's weight is split between its traces.
CALIBRATION_WEIGHTING=time
# Shrink the trader's probability toward 0.5 by the fitted factor (needs 50+ markets).
CALIBRATION_SHRINKAGE_ENABLED=false

# ── Build metadata (#66) ───────────────────────────────────────────────────
# Commit recorded in trace provenance. Optional; set by CI or the deploy.
GIT_SHA=

# ── LLM budgets and shared guards (#71) ────────────────────────────────────
# Per UTC day, across every provider and instance (state lives in Redis).
LLM_DAILY_TOKEN_BUDGET=2000000
# USD micro-units (1_000_000 = $1); an estimate from a static price table.
LLM_DAILY_COST_BUDGET_MICROS=20000000
# Percent of both budgets reserved for admin-triggered generation; cron work
# stops at budget - reserve.
LLM_ADMIN_RESERVE_PCT=10
LLM_ANTHROPIC_RPM=12
LLM_GEMINI_RPM=15
LLM_BREAKER_FAILURE_THRESHOLD=3
LLM_BREAKER_OPEN_MS=3600000
# closed: refuse LLM calls when Redis is down (recommended in production).
# open: fall back to a per-process limiter and log a warning.
LLM_REDIS_FAIL_MODE=closed

# ── LLM router (#157) ──────────────────────────────────────────────────────
# OpenAI or any OpenAI-compatible endpoint. The router can use them in a task
# policy even if Anthropic/Gemini are configured.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Optional JSON policy overriding some/all tasks, e.g.
# {"market_generation":[{"provider":"anthropic","model":"claude-sonnet-4-6",
#   "temperature":0.2,"maxTokens":4096,"timeoutMs":60000}]}
# Or a path to a JSON file. Missing tasks keep the built-in default policy.
LLM_POLICY=
LLM_POLICY_FILE=

# ── IPFS content store (#100) ──────────────────────────────────────────────
# Per-object cap and total Postgres budget for verified pinned bytes.
IPFS_CACHE_MAX_OBJECT_BYTES=262144
IPFS_CACHE_BUDGET_BYTES=268435456

# ── Transparency reports (#159) ────────────────────────────────────────────
REPORTS_ENABLED=false
REPORT_CRON=10 0 * * *
# dry-run: pin + persist, never publish on-chain. live: publish with the agent.
REPORT_MODE=dry-run
# URL placed in the report's method.doc field.
REPORT_METHOD_DOC=https://github.com/OracleDesk/oracledesk-backend/blob/main/docs/transparency-reports.md

# ── Treasury admin console (#156) ──────────────────────────────────────────
# Lifetime of a prepared unsigned transaction.
TREASURY_OP_TTL_SECONDS=3600
# Optional stricter backend policy for withdraw operations.
TREASURY_WITHDRAW_MIN_SIGNERS=0
# ── Resilience & Timeouts ──────────────────────────────────────────────────
TIMEOUT_RPC_READ_MS=8000
TIMEOUT_RPC_WRITE_MS=45000
TIMEOUT_RPC_EVENTS_MS=15000
TIMEOUT_LLM_MS=60000
TIMEOUT_IPFS_PIN_MS=20000
TIMEOUT_IPFS_FETCH_MS=15000
TIMEOUT_DATASOURCE_MS=10000

# Concurrency bulkheads
BULKHEAD_LLM=2
BULKHEAD_IPFS=4
BULKHEAD_RPC_READ=16
BULKHEAD_RPC_WRITE=4
BULKHEAD_RPC_EVENTS=4
BULKHEAD_DATASOURCE=8
BULKHEAD_QUEUE=32

# Deadlines & caps
HTTP_REQUEST_TIMEOUT_MS=30000
CYCLE_DEADLINE_MS=600000
IPFS_MAX_BYTES=2097152

# ── Trace Audit (Registry Verification) ────────────────────────────────────
TRACE_AUDIT_ENABLED=true
TRACE_AUDIT_CRON=40 */2 * * *
TRACE_AUDIT_RECHECK_HOURS=168
TRACE_AUDIT_MAX_RPC=500
TRACE_AUDIT_MAX_FETCHES=100
TRACE_AUDIT_MAX_BYTES=2097152

# Trace publication queue (#131): pins traces, waits for the market to be
# on-chain, publishes once, and confirms via the indexer's TracePublished event.
TRACE_PUBLISH_ENABLED=true
TRACE_PUBLISH_CRON=*/30 * * * * *
TRACE_PUBLISH_MAX_ATTEMPTS=8
TRACE_CONFIRM_TIMEOUT_MS=600000

# ── Copy Trading ───────────────────────────────────────────────────────────
COPY_TRADE_TTL_MINUTES=30
COPY_TRADE_MAX_PENDING=5

# ── Seed / snapshot (#147) ─────────────────────────────────────────────────
# The seed refuses production and non-local databases. Set to 1 only when you
# intentionally seed a remote development database.
SEED_ALLOW_REMOTE=0
# Base id for seeded on-chain market/trace rows, and the starting ledger.
SEED_ONCHAIN_BASE=1000000
SEED_BASE_LEDGER=6000000
# Optional comma-separated real testnet ids to link (read-only).
SEED_TESTNET_MARKET_IDS=
# Required by scripts/snapshot-export.ts; never commit the value.
SNAPSHOT_SALT=
