// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── ENUMS ───────────────────────────

enum MarketStatus {
  PENDING
  ACTIVE
  RESOLVING
  RESOLVED
  CANCELLED
}

enum MarketCategory {
  FED
  ECB
  ELECTION
  GEOPOLITICAL
  CRYPTO
  MACRO
  SPORTS
  ENTERTAINMENT
  POLITICS
}

/// market-core takes a single collateral token (USDC). EURC was dropped in the
/// Stellar port; see docs/api.md.
enum SettlementCurrency {
  USDC
}

enum TradeDirection {
  YES
  NO
}

enum TradeStatus {
  PENDING
  EXECUTED
  FAILED
  CANCELLED
}

enum CopyTradeStatus {
  PENDING
  CONFIRMING
  EXECUTED
  FAILED
  CANCELLED
  EXPIRED
}

enum PositionStatus {
  OPEN
  CLOSED
  HEDGED
  STOP_LOSS
}

enum SubscriptionType {
  PER_TRACE
  DAILY_PASS
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
  FAILED
  REVOKED
  LIMIT_REACHED
}

enum PaymentEventType {
  DAILY_PASS
  PER_TRACE
  REFUND
}

enum PaymentEventStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

/// Server-issued payment intents (#52). OPEN -> PENDING_PAYMENT -> CONFIRMED,
/// with FAILED / EXPIRED / REFUND_REQUIRED as terminal or manual-review states.
enum PaymentIntentStatus {
  OPEN
  PENDING_PAYMENT
  CONFIRMED
  FAILED
  EXPIRED
  REFUND_REQUIRED
}

/// Admin refund lifecycle (#57). Transitions are enforced in the service:
/// REQUESTED -> APPROVED -> PREPARED -> SUBMITTED -> CONFIRMED, plus REJECTED
/// from REQUESTED and FAILED from PREPARED/SUBMITTED.
enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PREPARED
  SUBMITTED
  CONFIRMED
  FAILED
}

enum GenerationJobStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum TraceAuditStatus {
  VERIFIED
  HASH_MISMATCH
  UNAVAILABLE
  UNKNOWN_TO_BACKEND
  WRONG_MARKET
  UNLINKED_IN_DB
  NOT_ON_CHAIN
  FOREIGN_AGENT
  ARCHIVED
}

enum AgentType {
  MARKET_MAKER
  TRADER
}

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

// ─────────────────────────── MODELS ───────────────────────────

/// How a custodial sub-identity is expressed on the signed challenge (#46).
/// `MUXED` is a CAP-27 / SEP-23 M… address; `MEMO` is a G… account with an id memo.
enum SubIdKind {
  MUXED
  MEMO
}

/// Registered subscribers who pay for reasoning traces.
///
/// `walletAddress` is the base G… account that signs and pays; it is no longer
/// unique so one pooled account can host many sub-users. `identityKey` is the
/// unique login identity: `G…`, `G…#muxed:<id>` or `G…#memo:<id>`.
model User {
  id            String         @id @default(uuid())
  walletAddress String
  subId         String?
  subIdKind     SubIdKind?
  identityKey   String         @unique
  email         String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subscriptions Subscription[]
  copyTrades    CopyTrade[]
  paymentEvents PaymentEvent[]
  spendingAllowance SpendingAllowance?
  refunds       Refund[]
  entitlementTokens EntitlementToken[]
  x402Settlements X402Settlement[]

  @@index([walletAddress])
  @@map("users")
}

/// AI-generated prediction markets, created on Stellar through the treasury contract
model Market {
  id                 String             @id @default(uuid())
  question           String
  category           MarketCategory
  status             MarketStatus       @default(PENDING)
  settlementCurrency SettlementCurrency @default(USDC)
  /// CHECK: markets_initial_yes_prob_range (initialYesProb >= 0 AND initialYesProb <= 1)
  initialYesProb     Float
  /// CHECK: markets_current_yes_prob_range (currentYesProb IS NULL OR (currentYesProb >= 0 AND currentYesProb <= 1))
  currentYesProb     Float?
  /// CHECK: markets_ci_shape (confidenceInterval is object with lower <= upper)
  confidenceInterval Json               // { lower: Float, upper: Float }
  expiryTimestamp    DateTime
  resolutionOracle   String?
  resolvedOutcome    Boolean?
  resolvedAt         DateTime?
  /// CHECK: markets_min_liquidity_nonneg (minimumLiquidity >= 0)
  minimumLiquidity   Float              @default(100)
  /// CHECK: markets_total_liquidity_nonneg (totalLiquidity >= 0)
  totalLiquidity     Float              @default(0)
  /// CHECK: markets_onchain_id_nonneg (onChainMarketId IS NULL OR onChainMarketId >= 0)
  /// market-core u64 market id. Serialised as a decimal string in JSON.
  onChainMarketId    BigInt?            @unique
  /// CHECK: markets_creation_tx_hash_format (creationTxHash IS NULL OR 64 hex chars)
  creationTxHash     String?
  /// CHECK: markets_creation_inner_tx_hash_format (creationInnerTxHash IS NULL OR 64 hex chars)
  /// Inner (pre-fee-bump) hash of the creation transaction (#38).
  creationInnerTxHash String?
  /// CHECK: markets_seed_amount_raw_digits (seedAmountRaw IS NULL OR digits only)
  /// Seed liquidity in 7-decimal USDC base units.
  seedAmountRaw      String?
  /// CHECK: markets_question_hash_format (questionHash IS NULL OR 64 hex chars)
  /// sha256 (hex) of the canonical question JSON pinned at metaUri.
  questionHash       String?
  metaUri            String?
  /// CHECK: markets_resolution_hash_format (resolutionHash IS NULL OR 64 hex chars)
  /// sha256(XDR(ResolutionSpec)) committed on-chain at creation (ADR 0001).
  resolutionHash     String?
  /// Revealed preimage of resolutionHash, kept so it can be registered with the resolver.
  resolutionSpec     Json?
  /// Seed policy inputs, bounds, binding constraint and expected LP loss (#82).
  seedPolicy         Json?
  /// Highest ledger whose chain state this row reflects; guards writes from the indexer and the reconciler (#83).
  chainSyncedLedger  Int?
  lastReconciledAt   DateTime?          @db.Timestamptz(3)
  /// Resolvability block pinned in question document v2 (source id, URL, measurable, comparator, threshold, deadline, instructions). Null for markets created before #74.
  resolutionDetails  Json?
  /// LlmProvenance of the call that proposed this market (#66). Null for older rows.
  generationProvenance Json?
  /// Embedding of the normalised question (#69), vector(768). Read and written with raw SQL only.
  questionEmbedding  Unsupported("vector(768)")?
  /// Model that produced questionEmbedding; vectors are compared only within one model.
  embeddingModel     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  generationJob MarketGenerationJob? @relation("MarketGenerationJobMarket")

  trades         Trade[]
  positions      Position[]
  hedgePositions Position[]          @relation("MarketHedgePositions")
  reasoningTraces ReasoningTrace[]
  copyTrades     CopyTrade[]
  agentLogs      AgentLog[]
  creationAttempt MarketCreationAttempt?

  @@index([status])
  @@index([category])
  @@index([expiryTimestamp])
  @@index([settlementCurrency])
  @@index([resolvedAt])
  @@index([lastReconciledAt])
  @@index([resolutionSpec], type: Gin)
  @@map("markets")
}

// Background job for market generation process, tracking status and errors
model MarketGenerationJob {
  id          String              @id @default(cuid())
  status      GenerationJobStatus @default(PROCESSING)
  marketId    String?             @unique
  traceId     String?
  error       String?
  startedAt   DateTime            @default(now())
  completedAt DateTime?

  market Market? @relation("MarketGenerationJobMarket", fields: [marketId], references: [id])

  @@index([status])
  @@map("market_generation_jobs")
}

/// Individual trade executed by the Trader Agent
model Trade {
  id           String         @id @default(uuid())
  marketId     String
  direction    TradeDirection
  status       TradeStatus    @default(PENDING)
  /// CHECK: trades_amount_nonneg (amount >= 0)
  amount       Float
  price        Float
  edgeDetected Float
  kellyFraction Float
  txHash       String?
  /// CHECK: trades_inner_tx_hash_format (innerTxHash IS NULL OR 64 hex chars)
  /// Inner (pre-fee-bump) hash; txHash is what appears on chain (#38).
  innerTxHash  String?
  builderFee   Float          @default(0)
  errorMessage String?
  executedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  market     Market      @relation(fields: [marketId], references: [id], onDelete: Cascade)
  position   Position?
  copyTrades CopyTrade[]

  @@index([marketId])
  @@index([status])
  @@index([createdAt])
  @@map("trades")
}

/// Tracks the open/closed lifecycle of an agent position
model Position {
  id           String         @id @default(uuid())
  marketId     String
  tradeId      String         @unique
  direction    TradeDirection
  status       PositionStatus @default(OPEN)
  /// CHECK: positions_entry_price_range (entryPrice >= 0 AND entryPrice <= 1)
  entryPrice   Float
  /// CHECK: positions_current_price_range (currentPrice IS NULL OR (currentPrice >= 0 AND currentPrice <= 1))
  currentPrice Float?
  size         Float
  pnl          Float          @default(0)
  /// Outcome shares held, from agent_buy's result (i128 base units, #77/#78). Null: legacy row.
  sharesRaw    Decimal?       @db.Decimal(39, 0)
  /// Collateral paid for the shares still held (base units). Reduced pro rata by partial exits.
  costBasisRaw Decimal?       @db.Decimal(39, 0)
  feesPaidRaw  Decimal?       @db.Decimal(39, 0)
  /// Collateral received from confirmed exits, and the PnL they realised.
  realisedCollateralRaw Decimal @default(0) @db.Decimal(39, 0)
  realisedPnlRaw        Decimal @default(0) @db.Decimal(39, 0)
  /// Mark to market (#78): mid price of the held outcome, mid value, value if sold now, and the latter minus cost.
  markPriceBps       Int?
  markValueRaw       Decimal?  @db.Decimal(39, 0)
  liquidationValueRaw Decimal? @db.Decimal(39, 0)
  unrealisedPnlRaw   Decimal?  @db.Decimal(39, 0)
  markedAt           DateTime? @db.Timestamptz(3)
  /// indexed | rpc | estimated
  valuationSource    String?
  /// The pool could not absorb a sale of all shares, so liquidation value is 0.
  illiquid           Boolean   @default(false)
  hedgeMarketId String?
  closedAt     DateTime?
  closeReason  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  market      Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  hedgeMarket Market? @relation("MarketHedgePositions", fields: [hedgeMarketId], references: [id], onDelete: SetNull)
  trade       Trade   @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  exits       PositionExit[]

  @@index([marketId])
  @@index([status])
  @@map("positions")
}

/// One attempt to sell shares of a position through treasury.agent_sell (#77).
model PositionExit {
  id               String   @id @default(uuid())
  positionId       String
  /// live | dry-run
  mode             String
  sharesSoldRaw    Decimal  @default(0) @db.Decimal(39, 0)
  collateralOutRaw Decimal  @db.Decimal(39, 0)
  maxSharesInRaw   Decimal  @db.Decimal(39, 0)
  /// collateralOut / sharesSold, for display.
  effectivePrice   Float?
  txHash           String?
  reason           String
  /// SUBMITTED | CONFIRMED | FAILED | SIMULATED
  status           String
  error            String?
  createdAt        DateTime @default(now())

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId])
  @@map("position_exits")
}

enum AgentControlScope {
  ALL
  MARKET_MAKER
  TRADER
}

/// Persistent pause / kill switch shared by every backend instance (#79).
model AgentControl {
  scope       AgentControlScope @id
  paused      Boolean           @default(false)
  reason      String?
  /// operator | drawdown | chain_paused | failure_breaker
  source      String?
  pausedUntil DateTime?
  /// Wallet address or 'system'.
  pausedBy    String?
  version     Int               @default(0)
  updatedAt   DateTime          @updatedAt

  @@map("agent_controls")
}

model AgentControlEvent {
  id        String            @id @default(uuid())
  scope     AgentControlScope
  action    String
  reason    String?
  source    String
  actor     String
  before    Json
  after     Json
  createdAt DateTime          @default(now())

  @@index([scope, createdAt])
  @@map("agent_control_events")
}

/// Structured AI reasoning trace for every decision
model ReasoningTrace {
  id                  String            @id @default(uuid())
  marketId            String
  agentType           AgentType
  decisionType        String
  sourcesUsed         Json              // Array<{ source, weight, signal }>
  /// CHECK: reasoning_traces_prob_est_range (probabilityEstimate >= 0 AND probabilityEstimate <= 1)
  probabilityEstimate Float
  /// CHECK: reasoning_traces_market_prob_range (marketProbability >= 0 AND marketProbability <= 1)
  marketProbability   Float
  edge                Float
  /// CHECK: reasoning_traces_ci_shape (confidenceInterval is object with lower <= upper)
  confidenceInterval  Json              // { lower: Float, upper: Float }
  betFraction         Float?
  betSizeUsdc         Float?
  hedgeConditions     Json?             // string[]
  /// TraceProvenance embedded in the pinned payload (#66). Null for older traces.
  provenance          Json?
  agentWallet         String?
  signature           String?
  ipfsCid             String?
  /// CHECK: reasoning_traces_trace_hash_format (traceHash IS NULL OR 64 hex chars)
  /// sha256 (hex) of the exact bytes pinned to IPFS.
  traceHash           String?
  /// CHECK: reasoning_traces_onchain_id_nonneg (onChainTraceId IS NULL OR onChainTraceId >= 0)
  /// reasoning-registry u64 trace id.
  onChainTraceId      BigInt?           @unique
  /// CHECK: reasoning_traces_publish_tx_hash_format (publishTxHash IS NULL OR 64 hex chars)
  publishTxHash       String?
  /// CHECK: reasoning_traces_publish_inner_tx_hash_format (publishInnerTxHash IS NULL OR 64 hex chars)
  /// Inner (pre-fee-bump) hash of the publish transaction (#38).
  publishInnerTxHash  String?
  verified            Boolean           @default(false)
  isPublic            Boolean           @default(false)
  previewSources      Json?             // First 2 sources (free preview)
  lastAuditStatus     TraceAuditStatus?
  lastAuditedAt       DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  market        Market         @relation(fields: [marketId], references: [id], onDelete: Cascade)
  copyTrades    CopyTrade[]
  subscriptions Subscription[]
  paymentEvents PaymentEvent[]
  audits        TraceAudit[]
  publication   TracePublication?

  @@index([marketId])
  @@index([ipfsCid])
  @@index([verified])
  @@index([traceHash])
  @@index([createdAt])
  @@index([marketId, createdAt])
  /// Retention (#73) keeps signals cited by a trace: `sourcesUsed @> [{"signalId": …}]`.
  @@index([sourcesUsed(ops: JsonbPathOps)], type: Gin)
  @@map("reasoning_traces")
}

/// Daily calibration metrics per slice (#68). Append-only; the API serves the latest computedAt.
model CalibrationSnapshot {
  id         String   @id @default(uuid())
  computedAt DateTime @default(now()) @db.Timestamptz(3)
  /// '30d' | '90d' | 'all'
  window     String
  /// 'agentType' | 'category' | 'decisionType' | 'promptVersion' | 'model' | 'agentType_category'
  groupBy    String
  groupKey   String
  /// brier, logLoss, baseline, buckets, murphy, nMarkets, nTraces, nEff, shrinkageK
  metrics    Json

  @@index([window, groupBy, computedAt])
  @@map("calibration_snapshots")
}

/// A subscriber copying an agent's trade
model CopyTrade {
  id                   String          @id @default(uuid())
  userId               String
  traceId              String
  marketId             String
  tradeId              String?
  direction            TradeDirection
  /// CHECK: copy_trades_amount_nonneg (amount >= 0)
  amount               Float
  /// CHECK: copy_trades_amount_raw_digits (amountRaw IS NULL OR digits only)
  amountRaw            String?
  /// CHECK: copy_trades_tx_hash_format (txHash IS NULL OR 64 hex chars)
  txHash               String?         @unique
  builderFee           Float           @default(0)
  status               CopyTradeStatus @default(PENDING)
  pnl                  Float?
  collateralRaw        String?
  sharesRaw            String?
  feeRaw               String?
  ledger               Int?
  chainEventId         String?
  confirmedAt          DateTime?
  failureCode          String?
  verificationAttempts Int             @default(0)
  expiresAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trace  ReasoningTrace @relation(fields: [traceId], references: [id], onDelete: Restrict)
  market Market         @relation(fields: [marketId], references: [id], onDelete: Restrict)
  trade  Trade?         @relation(fields: [tradeId], references: [id])

  @@index([userId])
  @@index([traceId])
  @@index([status])
  @@index([status, expiresAt])
  @@map("copy_trades")
}

/// Nanopayment subscription for trace access
model Subscription {
  id         String             @id @default(uuid())
  userId     String
  traceId    String?
  type       SubscriptionType
  status     SubscriptionStatus @default(ACTIVE)
  /// CHECK: subscriptions_amount_paid_nonneg (amountPaid >= 0)
  amountPaid Float
  currency   SettlementCurrency @default(USDC)
  /// CHECK: subscriptions_tx_hash_format (txHash IS NULL OR 64 hex chars)
  txHash     String?            @unique
  /// Ledger that contained the payment transaction (#54).
  purchaseLedger Int?
  /// Ledger-close-anchored coverage window (#54). expiresAt is kept for
  /// backwards compatibility and always mirrors endsAt for new rows.
  startsAt   DateTime?
  endsAt     DateTime?
  expiresAt  DateTime?
  /// Server-issued intent that settled this subscription (#52).
  paymentIntentId String?       @unique
  /// Set when the PASS_EXPIRING socket event was claimed for this pass (#94).
  expiryNotifiedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  trace ReasoningTrace? @relation(fields: [traceId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([userId, status, endsAt])
  @@map("subscriptions")
}

/// One admin refund request for one PaymentEvent (#57). The backend never
/// holds the revenue account's secret key: it only prepares unsigned XDR,
/// verifies the returned envelope byte-for-byte, submits it and confirms the
/// on-chain transfer before marking the payment refunded.
model Refund {
  id              String             @id @default(uuid())
  /// Refundable at most once: one refund row per payment event.
  paymentEventId  String             @unique
  userId          String
  /// Original payment amount in 7-decimal base units. CHECK: digits only.
  amountRaw       String
  currency        SettlementCurrency @default(USDC)
  status          RefundStatus       @default(REQUESTED)
  reason          String
  rejectionReason String?
  /// Base64 XDR of the simulated, unsigned SAC transfer.
  unsignedXdr     String?
  /// Hash of the exact prepared transaction body; signatures do not change it.
  preparedHash    String?
  preparedExpiresAt DateTime?
  /// Hash of the submitted transaction (unique: one refund per transaction).
  submittedTxHash String?            @unique
  ledger          Int?
  error           String?
  requestedBy     String
  approvedBy      String?
  preparedBy      String?
  submittedBy     String?
  requestedAt     DateTime           @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  preparedAt      DateTime?
  submittedAt     DateTime?
  confirmedAt     DateTime?
  failedAt        DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentEvent PaymentEvent @relation(fields: [paymentEventId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([userId])
  @@map("refunds")
}

/// A settlement reported by the x402 facilitator (#61). Inserting the row is
/// the exactly-once claim for the settlement transaction hash, so a retry can
/// resume recording a settled payment instead of charging again.
model X402Settlement {
  txHash         String             @id
  userId         String
  payer          String
  amountRaw      String
  currency       SettlementCurrency @default(USDC)
  network        String
  asset          String
  /// RECEIVED | RECORDED | FAILED
  status         String             @default("RECEIVED")
  paymentEventId String?            @unique
  subscriptionId String?
  attempts       Int                @default(0)
  lastError      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, createdAt])
  @@map("x402_settlements")
}

/// Issued trace-entitlement tokens (#62), kept so a refund or revocation can
/// revoke their jtis in Redis. The token itself carries no PII beyond the
/// user's public address.
model EntitlementToken {
  jti            String    @id
  userId         String
  subscriptionId String?
  traceId        String
  expiresAt      DateTime
  issuedAt       DateTime  @default(now())
  revokedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([expiresAt])
  @@map("entitlement_tokens")
}

/// Full audit trail of every agent decision and action
model AgentLog {
  id        String    @id @default(uuid())
  agentType AgentType
  level     LogLevel  @default(INFO)
  action    String
  marketId  String?
  data      Json?
  error     String?
  createdAt DateTime  @default(now())

  market Market? @relation(fields: [marketId], references: [id])

  @@index([agentType])
  @@index([level])
  @@index([createdAt])
  @@map("agent_logs")
}

/// Cached raw signal payloads from ingestion APIs
model SignalCache {
  id        String   @id @default(uuid())
  source    String
  payload   Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@index([source, expiresAt])
  @@map("signal_cache")
}

/// Normalised evidence with a stable identity (#73). One row per article URL
/// (or FRED observation), however often it is fetched; syndicated copies share
/// a clusterId. Trace payloads cite rows by id. Replaces SignalCache, which is
/// no longer written and is dropped in a follow-up migration.
model Signal {
  id                 String          @id @default(uuid())
  /// NEWSAPI | FRED | GDELT
  source             String
  /// sha256 of the canonical URL, or of FRED:<series>:<observation date>.
  dedupKey           String          @unique
  externalId         String?
  url                String?
  publisher          String?
  title              String
  summary            String?
  publishedAt        DateTime        @db.Timestamptz(3)
  firstSeenAt        DateTime        @default(now()) @db.Timestamptz(3)
  lastSeenAt         DateTime        @default(now()) @db.Timestamptz(3)
  seenCount          Int             @default(1)
  category           MarketCategory?
  categoryConfidence Float?
  /// Id of the oldest signal in this near-duplicate cluster (its own id when it started one).
  clusterId          String?
  /// FRED observation value.
  numericValue       Float?
  /// 64-bit SimHash of title + summary prefix, signed.
  simhash            BigInt?

  @@index([publishedAt])
  @@index([clusterId])
  @@index([source, lastSeenAt])
  @@index([category, publishedAt])
  @@map("signals")
}

/// One provider call (#73): when, how long, outcome and item counts.
model SignalFetch {
  id                 String   @id @default(uuid())
  source             String
  /// sha256 of the canonical request with credentials removed.
  requestFingerprint String
  startedAt          DateTime @default(now()) @db.Timestamptz(3)
  durationMs         Int
  /// ok | error | timeout | skipped_no_key
  status             String
  itemCount          Int      @default(0)
  /// Provider items dropped before storage (no URL, unparseable date, missing value).
  rejectedCount      Int      @default(0)
  error              String?
  rawPayloadId       String?

  @@index([source, startedAt])
  @@index([startedAt])
  @@map("signal_fetches")
}

/// Provider response as received, credentials stripped, kept for
/// SIGNAL_RAW_RETENTION_DAYS (#73).
model SignalRawPayload {
  id        String   @id @default(uuid())
  source    String
  payload   Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@map("signal_raw_payloads")
}

/// Ledger cursor for the Stellar event indexer, one row per network.
model IndexerCursor {
  id         String   @id
  lastLedger Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("indexer_cursors")
}

/// Contract events read from Stellar RPC getEvents. `id` is the RPC event id,
/// so re-reading a ledger range never inserts duplicates.
model ChainEvent {
  id             String   @id
  contractId     String
  contractName   String
  eventName      String
  ledger         Int
  ledgerClosedAt DateTime
  /// CHECK: chain_events_tx_hash_format (64 hex chars)
  txHash         String
  /// Decoded event params (bigints as strings).
  params         Json
  /// True once the event reached the event bus (or has nothing to publish).
  /// Rows stored before the bus existed are true.
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([contractName, eventName])
  @@index([ledger])
  @@index([txHash])
  @@index([published, ledger])
  @@map("chain_events")
}

// Event emitted for every payment transaction related to subscriptions and copy trading
model PaymentEvent {
  id            String             @id @default(uuid())
  userId        String
  /// CHECK: payment_events_tx_hash_format (64 hex chars)
  txHash        String             @unique
  type          PaymentEventType
  amount        Float
  /// CHECK: payment_events_amount_raw_digits (amountRaw IS NULL OR digits only)
  amountRaw     String?
  fromAddress   String?
  currency      SettlementCurrency @default(USDC)
  status        PaymentEventStatus @default(PENDING)
  traceId       String?
  /// Ledger / close time of the verified transfer (#53/#54).
  ledger        Int?
  ledgerCloseTime DateTime?
  /// Set when the verified amount exceeded the remaining spending approval.
  allowanceOverage Boolean         @default(false)
  allowanceOverageRaw Decimal?     @db.Decimal(39, 0)
  /// Server-issued intent that settled this payment (#52).
  paymentIntentId String?          @unique
  metadata      Json?
  createdAt     DateTime           @default(now())
  confirmedAt   DateTime?
  reconciled    Boolean            @default(false) // #56 reconciliation flag
  
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  trace ReasoningTrace? @relation(fields: [traceId], references: [id], onDelete: SetNull)
  refund Refund?

  @@index([userId])

}

// User-defined spending approvals for nanopayment trace access
model SpendingAllowance {
  id            String             @id @default(uuid())
  userId        String             @unique
  /// CHECK: spending_allowances_daily_limit_nonneg (dailyLimit >= 0)
  dailyLimit    Float
  /// CHECK: spending_allowances_per_trace_limit_nonneg (perTraceLimit >= 0)
  perTraceLimit Float
  /// CHECK: spending_allowances_spent_today_nonneg (spentToday >= 0)
  spentToday    Float              @default(0)
  /// Exact base-unit accounting (#53). The Float columns above are display
  /// mirrors; limits and spend are never enforced from them.
  dailyLimitRaw    Decimal          @default(0) @db.Decimal(39, 0)
  perTraceLimitRaw Decimal          @default(0) @db.Decimal(39, 0)
  spentTodayRaw    Decimal          @default(0) @db.Decimal(39, 0)
  /// Amount accepted while already at the limit; never silently discarded.
  overageRaw       Decimal          @default(0) @db.Decimal(39, 0)
  /// UTC day the raw counters belong to.
  windowStartedAt  DateTime         @default(now())
  currency      SettlementCurrency @default(USDC)
  lastResetAt   DateTime           @default(now())
  isActive      Boolean            @default(true)

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("spending_allowances")
}

