// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── ENUMS ───────────────────────────

enum MarketStatus {
  PENDING
  ACTIVE
  RESOLVING
  RESOLVED
  CANCELLED
}

enum MarketCategory {
  FED
  ECB
  ELECTION
  GEOPOLITICAL
  CRYPTO
  MACRO
  SPORTS
  ENTERTAINMENT
  POLITICS
}

/// market-core takes a single collateral token (USDC). EURC was dropped in the
/// Stellar port; see docs/api.md.
enum SettlementCurrency {
  USDC
}

enum TradeDirection {
  YES
  NO
}

enum TradeStatus {
  PENDING
  EXECUTED
  FAILED
  CANCELLED
}

enum CopyTradeStatus {
  PENDING
  CONFIRMING
  EXECUTED
  FAILED
  CANCELLED
  EXPIRED
}

enum PositionStatus {
  OPEN
  CLOSED
  HEDGED
  STOP_LOSS
}

enum SubscriptionType {
  PER_TRACE
  DAILY_PASS
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
  FAILED
  REVOKED
  LIMIT_REACHED
}

enum PaymentEventType {
  DAILY_PASS
  PER_TRACE
  REFUND
}

enum PaymentEventStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum GenerationJobStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum TraceAuditStatus {
  VERIFIED
  HASH_MISMATCH
  UNAVAILABLE
  UNKNOWN_TO_BACKEND
  WRONG_MARKET
  UNLINKED_IN_DB
  NOT_ON_CHAIN
  FOREIGN_AGENT
  ARCHIVED
}

enum AgentType {
  MARKET_MAKER
  TRADER
}

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

// ─────────────────────────── MODELS ───────────────────────────

/// Registered subscribers who pay for reasoning traces
model User {
  id            String         @id @default(uuid())
  walletAddress String         @unique
  email         String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subscriptions Subscription[]
  copyTrades    CopyTrade[]
  paymentEvents PaymentEvent[]
  spendingAllowance SpendingAllowance?

  @@index([walletAddress])
  @@map("users")
}

/// AI-generated prediction markets, created on Stellar through the treasury contract
model Market {
  id                 String             @id @default(uuid())
  question           String
  category           MarketCategory
  status             MarketStatus       @default(PENDING)
  settlementCurrency SettlementCurrency @default(USDC)
  /// CHECK: markets_initial_yes_prob_range (initialYesProb >= 0 AND initialYesProb <= 1)
  initialYesProb     Float
  /// CHECK: markets_current_yes_prob_range (currentYesProb IS NULL OR (currentYesProb >= 0 AND currentYesProb <= 1))
  currentYesProb     Float?
  /// CHECK: markets_ci_shape (confidenceInterval is object with lower <= upper)
  confidenceInterval Json               // { lower: Float, upper: Float }
  expiryTimestamp    DateTime
  resolutionOracle   String?
  resolvedOutcome    Boolean?
  resolvedAt         DateTime?
  /// CHECK: markets_min_liquidity_nonneg (minimumLiquidity >= 0)
  minimumLiquidity   Float              @default(100)
  /// CHECK: markets_total_liquidity_nonneg (totalLiquidity >= 0)
  totalLiquidity     Float              @default(0)
  /// CHECK: markets_onchain_id_nonneg (onChainMarketId IS NULL OR onChainMarketId >= 0)
  /// market-core u64 market id. Serialised as a decimal string in JSON.
  onChainMarketId    BigInt?            @unique
  /// CHECK: markets_creation_tx_hash_format (creationTxHash IS NULL OR 64 hex chars)
  creationTxHash     String?
  /// CHECK: markets_seed_amount_raw_digits (seedAmountRaw IS NULL OR digits only)
  /// Seed liquidity in 7-decimal USDC base units.
  seedAmountRaw      String?
  /// CHECK: markets_question_hash_format (questionHash IS NULL OR 64 hex chars)
  /// sha256 (hex) of the canonical question JSON pinned at metaUri.
  questionHash       String?
  metaUri            String?
  /// CHECK: markets_resolution_hash_format (resolutionHash IS NULL OR 64 hex chars)
  /// sha256(XDR(ResolutionSpec)) committed on-chain at creation (ADR 0001).
  resolutionHash     String?
  /// Revealed preimage of resolutionHash, kept so it can be registered with the resolver.
  resolutionSpec     Json?
  /// Seed policy inputs, bounds, binding constraint and expected LP loss (#82).
  seedPolicy         Json?
  /// Highest ledger whose chain state this row reflects; guards writes from the indexer and the reconciler (#83).
  chainSyncedLedger  Int?
  lastReconciledAt   DateTime?          @db.Timestamptz(3)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  generationJob MarketGenerationJob? @relation("MarketGenerationJobMarket")

  trades         Trade[]
  positions      Position[]
  hedgePositions Position[]          @relation("MarketHedgePositions")
  reasoningTraces ReasoningTrace[]
  copyTrades     CopyTrade[]
  agentLogs      AgentLog[]

  @@index([status])
  @@index([category])
  @@index([expiryTimestamp])
  @@index([settlementCurrency])
  @@index([resolvedAt])
  @@index([lastReconciledAt])
  @@map("markets")
}

// Background job for market generation process, tracking status and errors
model MarketGenerationJob {
  id          String              @id @default(cuid())
  status      GenerationJobStatus @default(PROCESSING)
  marketId    String?             @unique
  traceId     String?
  error       String?
  startedAt   DateTime            @default(now())
  completedAt DateTime?

  market Market? @relation("MarketGenerationJobMarket", fields: [marketId], references: [id])

  @@index([status])
  @@map("market_generation_jobs")
}

/// Individual trade executed by the Trader Agent
model Trade {
  id           String         @id @default(uuid())
  marketId     String
  direction    TradeDirection
  status       TradeStatus    @default(PENDING)
  /// CHECK: trades_amount_nonneg (amount >= 0)
  amount       Float
  price        Float
  edgeDetected Float
  kellyFraction Float
  txHash       String?
  builderFee   Float          @default(0)
  errorMessage String?
  executedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  market     Market      @relation(fields: [marketId], references: [id], onDelete: Cascade)
  position   Position?
  copyTrades CopyTrade[]

  @@index([marketId])
  @@index([status])
  @@index([createdAt])
  @@map("trades")
}

/// Tracks the open/closed lifecycle of an agent position
model Position {
  id           String         @id @default(uuid())
  marketId     String
  tradeId      String         @unique
  direction    TradeDirection
  status       PositionStatus @default(OPEN)
  /// CHECK: positions_entry_price_range (entryPrice >= 0 AND entryPrice <= 1)
  entryPrice   Float
  /// CHECK: positions_current_price_range (currentPrice IS NULL OR (currentPrice >= 0 AND currentPrice <= 1))
  currentPrice Float?
  size         Float
  pnl          Float          @default(0)
  hedgeMarketId String?
  closedAt     DateTime?
  closeReason  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  market      Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  hedgeMarket Market? @relation("MarketHedgePositions", fields: [hedgeMarketId], references: [id], onDelete: SetNull)
  trade       Trade   @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([marketId])
  @@index([status])
  @@map("positions")
}

/// Structured AI reasoning trace for every decision
model ReasoningTrace {
  id                  String            @id @default(uuid())
  marketId            String
  agentType           AgentType
  decisionType        String
  sourcesUsed         Json              // Array<{ source, weight, signal }>
  /// CHECK: reasoning_traces_prob_est_range (probabilityEstimate >= 0 AND probabilityEstimate <= 1)
  probabilityEstimate Float
  /// CHECK: reasoning_traces_market_prob_range (marketProbability >= 0 AND marketProbability <= 1)
  marketProbability   Float
  edge                Float
  /// CHECK: reasoning_traces_ci_shape (confidenceInterval is object with lower <= upper)
  confidenceInterval  Json              // { lower: Float, upper: Float }
  betFraction         Float?
  betSizeUsdc         Float?
  hedgeConditions     Json?             // string[]
  /// TraceProvenance embedded in the pinned payload (#66). Null for older traces.
  provenance          Json?
  agentWallet         String?
  signature           String?
  ipfsCid             String?
  /// CHECK: reasoning_traces_trace_hash_format (traceHash IS NULL OR 64 hex chars)
  /// sha256 (hex) of the exact bytes pinned to IPFS.
  traceHash           String?
  /// CHECK: reasoning_traces_onchain_id_nonneg (onChainTraceId IS NULL OR onChainTraceId >= 0)
  /// reasoning-registry u64 trace id.
  onChainTraceId      BigInt?           @unique
  /// CHECK: reasoning_traces_publish_tx_hash_format (publishTxHash IS NULL OR 64 hex chars)
  publishTxHash       String?
  verified            Boolean           @default(false)
  isPublic            Boolean           @default(false)
  previewSources      Json?             // First 2 sources (free preview)
  lastAuditStatus     TraceAuditStatus?
  lastAuditedAt       DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  market        Market         @relation(fields: [marketId], references: [id], onDelete: Cascade)
  copyTrades    CopyTrade[]
  subscriptions Subscription[]
  paymentEvents PaymentEvent[]
  audits        TraceAudit[]
  publication   TracePublication?

  @@index([marketId])
  @@index([ipfsCid])
  @@index([verified])
  @@index([traceHash])
  @@index([createdAt])
  @@index([marketId, createdAt])
  @@map("reasoning_traces")
}

/// Daily calibration metrics per slice (#68). Append-only; the API serves the latest computedAt.
model CalibrationSnapshot {
  id         String   @id @default(uuid())
  computedAt DateTime @default(now()) @db.Timestamptz(3)
  /// '30d' | '90d' | 'all'
  window     String
  /// 'agentType' | 'category' | 'decisionType' | 'promptVersion' | 'model' | 'agentType_category'
  groupBy    String
  groupKey   String
  /// brier, logLoss, baseline, buckets, murphy, nMarkets, nTraces, nEff, shrinkageK
  metrics    Json

  @@index([window, groupBy, computedAt])
  @@map("calibration_snapshots")
}

/// A subscriber copying an agent's trade
model CopyTrade {
  id                   String          @id @default(uuid())
  userId               String
  traceId              String
  marketId             String
  tradeId              String?
  direction            TradeDirection
  /// CHECK: copy_trades_amount_nonneg (amount >= 0)
  amount               Float
  /// CHECK: copy_trades_amount_raw_digits (amountRaw IS NULL OR digits only)
  amountRaw            String?
  /// CHECK: copy_trades_tx_hash_format (txHash IS NULL OR 64 hex chars)
  txHash               String?         @unique
  builderFee           Float           @default(0)
  status               CopyTradeStatus @default(PENDING)
  pnl                  Float?
  collateralRaw        String?
  sharesRaw            String?
  feeRaw               String?
  ledger               Int?
  chainEventId         String?
  confirmedAt          DateTime?
  failureCode          String?
  verificationAttempts Int             @default(0)
  expiresAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trace  ReasoningTrace @relation(fields: [traceId], references: [id], onDelete: Restrict)
  market Market         @relation(fields: [marketId], references: [id], onDelete: Restrict)
  trade  Trade?         @relation(fields: [tradeId], references: [id])

  @@index([userId])
  @@index([traceId])
  @@index([status])
  @@index([status, expiresAt])
  @@map("copy_trades")
}

/// Nanopayment subscription for trace access
model Subscription {
  id         String             @id @default(uuid())
  userId     String
  traceId    String?
  type       SubscriptionType
  status     SubscriptionStatus @default(ACTIVE)
  /// CHECK: subscriptions_amount_paid_nonneg (amountPaid >= 0)
  amountPaid Float
  currency   SettlementCurrency @default(USDC)
  /// CHECK: subscriptions_tx_hash_format (txHash IS NULL OR 64 hex chars)
  txHash     String?            @unique
  expiresAt  DateTime?
  /// Set when the PASS_EXPIRING socket event was claimed for this pass (#94).
  expiryNotifiedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  trace ReasoningTrace? @relation(fields: [traceId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("subscriptions")
}

/// Full audit trail of every agent decision and action
model AgentLog {
  id        String    @id @default(uuid())
  agentType AgentType
  level     LogLevel  @default(INFO)
  action    String
  marketId  String?
  data      Json?
  error     String?
  createdAt DateTime  @default(now())

  market Market? @relation(fields: [marketId], references: [id])

  @@index([agentType])
  @@index([level])
  @@index([createdAt])
  @@map("agent_logs")
}

/// Cached raw signal payloads from ingestion APIs
model SignalCache {
  id        String   @id @default(uuid())
  source    String
  payload   Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@index([source, expiresAt])
  @@map("signal_cache")
}

/// Ledger cursor for the Stellar event indexer, one row per network.
model IndexerCursor {
  id         String   @id
  lastLedger Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("indexer_cursors")
}

/// Contract events read from Stellar RPC getEvents. `id` is the RPC event id,
/// so re-reading a ledger range never inserts duplicates.
model ChainEvent {
  id             String   @id
  contractId     String
  contractName   String
  eventName      String
  ledger         Int
  ledgerClosedAt DateTime
  /// CHECK: chain_events_tx_hash_format (64 hex chars)
  txHash         String
  /// Decoded event params (bigints as strings).
  params         Json
  /// True once the event reached the event bus (or has nothing to publish).
  /// Rows stored before the bus existed are true.
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([contractName, eventName])
  @@index([ledger])
  @@index([txHash])
  @@index([published, ledger])
  @@map("chain_events")
}

// Event emitted for every payment transaction related to subscriptions and copy trading
model PaymentEvent {
  id            String             @id @default(uuid())
  userId        String
  /// CHECK: payment_events_tx_hash_format (64 hex chars)
  txHash        String             @unique
  type          PaymentEventType
  amount        Float
  /// CHECK: payment_events_amount_raw_digits (amountRaw IS NULL OR digits only)
  amountRaw     String?
  fromAddress   String?
  currency      SettlementCurrency @default(USDC)
  status        PaymentEventStatus @default(PENDING)
  traceId       String?
  metadata      Json?
  createdAt     DateTime           @default(now())
  confirmedAt   DateTime?

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  trace ReasoningTrace? @relation(fields: [traceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([txHash])
  @@map("payment_events")
}

// User-defined spending approvals for nanopayment trace access
model SpendingAllowance {
  id            String             @id @default(uuid())
  userId        String             @unique
  /// CHECK: spending_allowances_daily_limit_nonneg (dailyLimit >= 0)
  dailyLimit    Float
  /// CHECK: spending_allowances_per_trace_limit_nonneg (perTraceLimit >= 0)
  perTraceLimit Float
  /// CHECK: spending_allowances_spent_today_nonneg (spentToday >= 0)
  spentToday    Float              @default(0)
  currency      SettlementCurrency @default(USDC)
  lastResetAt   DateTime           @default(now())
  isActive      Boolean            @default(true)

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("spending_allowances")
}

/// Exact bytes of IPFS documents the backend pinned or verified (#100).
model IpfsContent {
  cid          String    @id
  /// sha256 hex of `bytes`; the only admission criterion.
  sha256       String
  size         Int
  bytes        Bytes
  /// PINNED | GATEWAY_VERIFIED
  origin       String
  /// e.g. "pin" or "reasoning_registry:trace:12".
  verifiedBy   String?
  createdAt    DateTime  @default(now())
  lastAccessAt DateTime  @default(now())
  pinnedUntil  DateTime?

  @@index([sha256])
  @@index([lastAccessAt])
  @@map("ipfs_content")
}

/// Unsigned admin transactions prepared by the treasury operations console (#156).
model AdminOperation {
  id              String   @id @default(uuid())
  kind            String
  params          Json
  contractId      String
  sourceAccount   String
  unsignedXdr     String
  /// Hash of the prepared transaction body; signatures do not change it.
  txHash          String   @unique
  signedXdr       String?
  signatures      Json     @default("[]")
  weightCollected Int      @default(0)
  /// PREPARED | PARTIALLY_SIGNED | READY | SUBMITTED | SUCCESS | FAILED | EXPIRED | CANCELLED
  status          String
  resultXdr       String?
  ledger          Int?
  error           Json?
  requestedBy     String
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@map("admin_operations")
}

/// On-chain transparency reports published by the daily job (#159).
model TransparencyReport {
  id             String   @id @default(uuid())
  /// UTC day, YYYY-MM-DD.
  date           String   @unique
  anchorLedger   Int
  cid            String
  hash           String
  onChainTraceId BigInt?
  mode           String
  /// exact | best_effort
  consistency    String
  report         Json
  createdAt      DateTime @default(now())

  @@index([anchorLedger])
  @@map("transparency_reports")
}

/// Immutable reasoning-registry traces, cached so report counts do not walk
/// the whole registry on every run (#159).
model RegistryTraceCache {
  traceId     BigInt   @id
  agent       String
  marketId    BigInt
  action      String
  traceHash   String
  ipfsCid     String
  publishedAt BigInt
  fetchedAt   DateTime @default(now())

  @@index([agent, action])
  @@map("registry_trace_cache")
}

/// Runs of the reasoning trace auditor
model TraceAuditRun {
  id            String    @id @default(uuid())
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  cursorTraceId BigInt?
  stats         Json?

  @@map("trace_audit_runs")
}

/// Audit findings per on-chain / DB trace
model TraceAudit {
  id              String           @id @default(uuid())
  onChainTraceId  BigInt?
  traceId         String?
  onChainMarketId BigInt?
  agent           String?
  action          String?
  ipfsCid         String?
  onChainHash     String?
  computedHash    String?
  status          TraceAuditStatus
  detail          Json?
  runId           String
  checkedAt       DateTime         @default(now())

  trace ReasoningTrace? @relation(fields: [traceId], references: [id], onDelete: SetNull)

  @@unique([onChainTraceId, runId])
  @@index([status, checkedAt])
  @@index([traceId, checkedAt])
  @@map("trace_audits")
}

/// Rows violating constraints quarantined before repair
model ConstraintQuarantine {
  id        String   @id @default(uuid())
  tableName String   @map("table_name")
  rowId     String   @map("row_id")
  checkName String   @map("check_name")
  row       Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tableName, checkName])
  @@map("constraint_quarantine")
}

/// Lifecycle of a reasoning trace's on-chain publication (#131).
enum TracePublicationStatus {
  AWAITING_PIN
  AWAITING_MARKET
  READY
  SUBMITTED
  CONFIRMED
  FAILED
}

/// Durable queue row: one per trace that should be published to
/// reasoning-registry. Processed by src/jobs/trace-publication.worker.ts.
model TracePublication {
  id               String                 @id @default(uuid())
  traceId          String                 @unique
  action           String
  /// Exact trace document; pinned bytes = canonicalBytes(payload). Null only
  /// for backfilled rows whose trace was already pinned.
  payload          Json?
  status           TracePublicationStatus @default(AWAITING_PIN)
  attempts         Int                    @default(0)
  lastError        String?
  nextAttemptAt    DateTime               @default(now())
  submittedTxHash  String?
  /// Trace id returned by the publish_trace write, used to re-check chain state.
  submittedTraceId BigInt?
  confirmedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  trace ReasoningTrace @relation(fields: [traceId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("trace_publications")
}

/// Idempotency-Key records for state-changing endpoints (#123). One row per
/// (scope, method, route, key); see src/middlewares/idempotency.middleware.ts.
model IdempotencyKey {
  id              String   @id @default(uuid())
  /// userId, or "anon" for unauthenticated routes
  scope           String
  method          String
  /// Route template, e.g. "/api/v1/trade/copy"
  route           String
  key             String
  /// sha256 of the canonical request (method, route, params, query, body)
  fingerprint     String
  /// IN_PROGRESS | COMPLETED
  status          String
  lockedUntil     DateTime
  responseCode    Int?
  responseBody    Json?
  responseHeaders Json?
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@unique([scope, method, route, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}


/// Empirical pairwise market correlations, recomputed on a schedule (#80).
model CorrelationSnapshot {
  id           String   @id @default(uuid())
  computedAt   DateTime @default(now()) @db.Timestamptz(3)
  gridStepSecs Int
  windowDays   Int
  /// [{ a, b, rho, n, method: 'empirical'|'prior', sample, prior, delta }], backend market ids with a < b.
  pairs        Json

  @@index([computedAt])
  @@map("correlation_snapshots")
}

/// One drift finding from the market lifecycle reconciler (#83).
model MarketDriftReport {
  id              String   @id @default(uuid())
  runId           String
  marketId        String
  onChainMarketId BigInt
  driftClass      String
  dbValue         Json
  chainValue      Json
  /// REPAIRED | REPORTED | DEFERRED | SKIPPED_NEWER
  action          String
  observedLedger  Int
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([runId])
  @@index([driftClass, createdAt])
  @@map("market_drift_reports")
}

model ReconcileRun {
  id         String    @id @default(uuid())
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime?           @db.Timestamptz(3)
  scanned    Int       @default(0)
  repaired   Int       @default(0)
  reported   Int       @default(0)
  deferred   Int       @default(0)
  rpcCalls   Int       @default(0)
  error      String?

  @@map("reconcile_runs")
}
