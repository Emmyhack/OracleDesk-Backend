  reported   Int       @default(0)
  deferred   Int       @default(0)
  rpcCalls   Int       @default(0)
  error      String?

  @@map("reconcile_runs")
}

/// Transaction outbox: every live write persists its signed inner envelope here
/// before submission, and a recovery worker polls and fee-bumps stuck rows
/// (#38). The inner `hash` is the identity; fee-bump envelopes are extra.
/// Outbox state machine (#35): BUILT → SIGNED → SUBMITTED → PENDING →
/// SUCCESS | FAILED | EXPIRED. PENDING means submitted and handed to the
/// recovery worker after the inline wait expired.
enum ChainTxStatus {
  BUILT
  SIGNED
  SUBMITTED
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

/// Transactional outbox (#35, #38): every live write persists its signed
/// inner envelope and hash before submission, a recovery worker resolves
/// non-terminal rows after a crash, and the fee-bump pass wraps stuck rows.
model ChainTransaction {
  id String @id @default(uuid())
  /// Completion-handler key: market.create | trade.buy | trade.sell | trace.publish | <contract>.<method>.
  kind   String
  /// Domain row the write belongs to (Market.id | Trade.id | PositionExit.id | ReasoningTrace.id).
  refId  String?
  contract String?
  method   String?
  args     Json?
  simulated Json?
  /// Transaction source account (agent or leased channel).
  source   String?
  sequence String?
  /// Inner transaction hash (hex). The outbox identity and dedup key.
  hash   String? @unique
  /// Signed inner envelope (base64 XDR), wrapped unchanged by a fee bump.
  envelopeXdr String?
  status      ChainTxStatus @default(BUILT)
  submitLedger Int?
  /// Timebounds (unix seconds); a bump cannot extend maxTime.
  minTime      BigInt?
  maxTime      BigInt?
  /// Ledger the transaction landed in.
  ledger       Int?
  resultXdr    String?
  /// Native return value (printable form) once the write landed.
  returnValue  Json?
  innerFee     String?
  resourceFee  String?
  /// Outer (fee-bump) hashes, in submission order.
  feeBumpHashes String[] @default([])
  /// Array of { hash, fee, xdr, at } for each bump built.
  feeBumpEnvelopes Json?
  /// The hash that actually executed on chain (outer when bumped).
  landedHash   String?
  bumpAttempts Int @default(0)
  attempts     Int @default(0)
  error        String?
  /// When the completion handler ran for a terminal status.
  handledAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([status, updatedAt])
  @@index([landedHash])
  @@index([kind, refId])
  @@index([feeBumpHashes], type: Gin)
  @@map("chain_transactions")
}

/// On-chain fees recorded per transaction (#39).
model ChainFee {
  txHash       String   @id @map("tx_hash")
  opClass      String   @map("op_class")
  inclusionFee BigInt   @map("inclusion_fee")
  resourceFee  BigInt   @map("resource_fee")
  totalFee     BigInt   @map("total_fee")
  feeCharged   BigInt?  @map("fee_charged")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([opClass, createdAt])
  @@map("chain_fees")
}

/// On-chain transaction submissions and lifetime tracking (#42).
model ChainSubmission {
  txHash               String   @id @map("tx_hash")
  opClass              String   @map("op_class")
  minTime              BigInt   @default(0) @map("min_time")
  maxTime              BigInt   @map("max_time")
  authExpirationLedger Int?     @map("auth_expiration_ledger")
  submittedLedger      Int?     @map("submitted_ledger")
  submittedAtCloseTime BigInt?  @map("submitted_at_close_time")
  decision             String   @map("decision")
  rebuildCount         Int      @default(0) @map("rebuild_count")
  attemptId            String?  @map("attempt_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([opClass, createdAt])
  @@index([attemptId])
  @@map("chain_submissions")
}

/// Idempotent market creation attempts (#41).
model MarketCreationAttempt {
  id                        String    @id @default(uuid())
  marketId                  String    @unique @map("market_id")
  market                    Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  status                    String    @map("status") // CLAIMED, SUBMITTED, LANDED, UNKNOWN, EXPIRED
  attempts                  Int       @default(0) @map("attempts")
  claimedAt                 DateTime? @map("claimed_at")
  claimLeaseExpiresAt       DateTime? @map("claim_lease_expires_at")
  questionHash              String?   @map("question_hash")
  resolutionHash            String?   @map("resolution_hash")
  preSubmissionMarketCount  BigInt?   @map("pre_submission_market_count")
  postSubmissionMarketCount BigInt?   @map("post_submission_market_count")
  txHash                    String?   @map("tx_hash")
  onChainMarketId           BigInt?   @map("on_chain_market_id")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  @@index([questionHash])
  @@index([status, claimedAt])
  @@map("market_creation_attempts")
}

/// Database-backed admin RBAC (#49). Roles are fixed values seeded on first
/// boot; assignments are the source of truth after that. JWT claims never
/// carry permissions.
model AdminPermission {
  key         String   @id
  description String?
  createdAt   DateTime @default(now())
  roles       AdminRolePermission[]
  @@map("admin_permissions")
}

model AdminRole {
  name        String   @id
  description String?
  createdAt   DateTime @default(now())
  permissions AdminRolePermission[]
  assignments AdminRoleAssignment[]
  @@map("admin_roles")
}

model AdminRolePermission {
  roleName      String
  permissionKey String
  role          AdminRole       @relation(fields: [roleName], references: [name], onDelete: Cascade)
  permission    AdminPermission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  createdAt     DateTime        @default(now())

  @@id([roleName, permissionKey])
  @@index([permissionKey])
  @@map("admin_role_permissions")
}

model AdminRoleAssignment {
  id            String   @id @default(uuid())
  walletAddress String   @unique
  roleName      String
  assignedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  role          AdminRole @relation(fields: [roleName], references: [name], onDelete: Restrict)

  @@index([roleName])
  @@map("admin_role_assignments")
}

/// Append-only audit trail for admin actions (#49). The migration adds a
/// trigger that rejects UPDATE and DELETE.
model AdminAuditLog {
  id         String   @id @default(uuid())
  actor      String
  action     String
  target     String?
  roleName   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actor, createdAt])
  @@index([target])
  @@map("admin_audit_logs")
}

/// A server-issued payment intent (#52): the server fixes the amount, memo,
/// recipient and expiry so a pending transaction can be confirmed without the
/// client resubmitting arbitrary details.
model PaymentIntent {
  id              String              @id @default(uuid())
  userId          String
  /// Base account that must be the verified sender.
  walletAddress   String
  status          PaymentIntentStatus @default(OPEN)
  type            SubscriptionType    @default(DAILY_PASS)
  amountRaw       Decimal             @db.Decimal(39, 0)
  currency        SettlementCurrency  @default(USDC)
  recipient       String
  token           String
  memo            String              @unique
  nonce           String              @unique
  txHash          String?             @unique
  subscriptionId  String?             @unique
  paymentEventId  String?             @unique
  overpaymentRaw  Decimal?            @db.Decimal(39, 0)
  underpaymentRaw Decimal?            @db.Decimal(39, 0)
  latePayment     Boolean             @default(false)
  refundRequired  Boolean             @default(false)
  attempts        Int                 @default(0)
  nextAttemptAt   DateTime?
  expiresAt       DateTime
  submittedAt     DateTime?
  confirmedAt     DateTime?
  expiredAt       DateTime?
  failureCode     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId, status])
  @@index([status, nextAttemptAt])
  @@index([expiresAt])
  @@map("payment_intents")
}

/// External resolution signer attestations coordinated through the signer API (#91).
/// `status`: PREPARED | SUBMITTED | CONFIRMED | FAILED.
model SignerAttestation {
  id              String   @id @default(uuid())
  marketId        String
  onChainMarketId BigInt
  signer          String
  /// YES | NO
  outcome         String
  status          String
  preparedXdr     String
  /// Hash of the prepared envelope (network-bound); signatures do not change it.
  preparedHash    String
  validUntil      DateTime
  txHash          String?
  ledger          Int?
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([onChainMarketId, signer, outcome])
  @@index([marketId])
  @@map("signer_attestations")
}

/// Independent review of one ResolutionProposed event (#92).
/// `verdict`: PENDING | AGREE | DISAGREE | INSUFFICIENT | ERROR.
model DisputeReview {
  id                 String    @id @default(uuid())
  onChainMarketId    BigInt
  /// chain_events.id of the ResolutionProposed event (or `missed:<market>` for the polling fallback).
  proposalEventId    String    @unique
  proposedOutcome    String
  /// Ledger seconds. Null when the proposal was found by polling and its time is unknown.
  proposedAt         BigInt?
  windowEndsAt       BigInt?
  verdict            String
  independentOutcome String?
  confidence         Float?
  evidence           Json?
  evidenceHash       String?
  acknowledgedBy     String?
  acknowledgedAt     DateTime?
  /// FINALIZED | CANCELLED | null
  resolvedAs         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([verdict])
  @@index([onChainMarketId])
  @@map("dispute_reviews")
}

/// One alert sent (or attempted) for a review, deduplicated by `dedupeKey`.
model AlertDelivery {
  id        String    @id @default(uuid())
  reviewId  String
  /// INFO | WARN | CRITICAL
  level     String
  sink      String
  /// reviewId:level:sink
  dedupeKey String    @unique
  /// SENT | FAILED
  status    String
  attempts  Int       @default(0)
  sentAt    DateTime?
  error     String?

  @@index([reviewId])
  @@map("alert_deliveries")
}
