              "marketIdA": "m-new",
              "marketIdB": "m-held",
              "correlationScore": 0.7,
              "relationship": "POSITIVE",
              "method": "matrix"
            }
          ],
          "method": "matrix",
          "snapshotId": null
        }
      }
    },
    {
      "call": "market.findUnique",
      "args": {
        "where": {
          "id": "m-new"
        }
      }
    },
    {
      "call": "position.findFirst",
      "args": {
        "where": {
          "marketId": "m-new",
          "status": "OPEN"
        }
      }
    },
    {
