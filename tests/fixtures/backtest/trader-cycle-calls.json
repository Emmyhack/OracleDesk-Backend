{
  "cycle": [
    {
      "call": "position.findMany",
      "args": {
        "where": {
          "status": {
            "in": [
              "CLOSED",
              "STOP_LOSS"
            ]
          },
          "closedAt": {
            "gte": "<iso>"
          }
        },
        "select": {
          "pnl": true
        }
      }
    },
    {
      "call": "position.findMany",
      "args": {
        "where": {
          "status": "OPEN",
          "sharesRaw": {
            "not": null
          }
        },
        "include": {
          "market": {
            "select": {
              "id": true,
              "onChainMarketId": true,
              "status": true
            }
          }
        }
      }
    },
    {
      "call": "position.findMany",
      "args": {
        "where": {
          "status": "OPEN"
        }
      }
    },
    {
      "call": "position.findUnique",
      "args": {
        "where": {
          "id": "p-stop"
        }
      }
    },
    {
      "call": "exitPosition",
      "id": "p-stop",
      "reason": "STOP_LOSS"
    },
    {
      "call": "position.findUnique",
      "args": {
        "where": {
          "id": "p-hold"
        }
      }
    },
    {
      "call": "position.findMany",
      "args": {
        "where": {
          "status": "OPEN"
        },
        "include": {
          "market": {
            "select": {
              "id": true,
              "category": true,
              "currentYesProb": true,
              "totalLiquidity": true
            }
          },
          "trade": true
        }
      }
    },
    {
      "call": "market.findFirst",
      "args": {
        "where": {
          "category": "CRYPTO",
          "id": {
            "not": "m-stop"
          },
          "status": "ACTIVE",
          "totalLiquidity": {
            "gte": 500
          }
        },
        "orderBy": {
          "totalLiquidity": "desc"
        }
      }
    },
    {
      "call": "market.findUnique",
      "args": {
        "where": {
          "id": "m-hedge"
        }
      }
    },
    {
      "call": "trade.create",
      "args": {
        "data": {
          "marketId": "m-hedge",
          "direction": "NO",
          "status": "PENDING",
          "amount": 50,
          "price": 0.5,
          "edgeDetected": 0,
          "kellyFraction": 0
        }
      }
    },
    {
      "call": "agentLog.create",
      "args": {
        "data": {
          "agentType": "TRADER",
          "level": "INFO",
          "action": "AUTO_HEDGE_EXECUTED",
          "marketId": "m-hedge",
          "data": {
            "originalMarketId": "m-stop",
            "hedgeTradeId": "t-10",
            "hedgeDirection": "NO",
            "hedgeSize": 50,
            "rationale": "Edge decayed from 0.200 to 0.400. Partial hedge of 50 USDC via m-hedge reduces net exposure by ~50%.",
            "correlation": {}
          }
        }
      }
    },
    {
      "call": "aggregateSignals"
    },
    {
      "call": "market.findMany",
      "args": {
        "where": {
          "status": "ACTIVE",
          "totalLiquidity": {
            "gte": 500
          },
          "expiryTimestamp": {
            "gt": "<iso>",
            "lte": "<iso>"
          }
        }
      }
    },
    {
      "call": "position.findFirst",
      "args": {
        "where": {
          "marketId": "m-new",
          "status": "OPEN"
        }
      }
    },
    {
      "call": "calculateProbability",
      "marketProb": 0.4
    },
    {
      "call": "market.findUnique",
      "args": {
        "where": {
          "id": "m-new"
        },
        "select": {
          "category": true,
          "id": true
        }
      }
    },
    {
      "call": "position.findMany",
      "args": {
        "where": {
          "status": "OPEN"
        },
        "include": {
          "market": {
            "select": {
              "id": true,
              "category": true
            }
          }
        }
      }
    },
    {
      "call": "correlationSnapshot.findFirst",
      "args": {
        "orderBy": {
          "computedAt": "desc"
        }
      }
    },
    {
      "call": "generateReasoningTrace",
      "input": {
        "marketId": "m-new",
        "agentType": "TRADER",
        "decisionType": "OPEN_POSITION",
        "sourcesUsed": [
          {
            "source": "NEWSAPI",
            "weight": 0.7,
