        "min_shares_out": "990000n"
      }
    },
    {
      "call": "trade.update",
      "args": {
        "where": {
          "id": "t-22"
        },
        "data": {
          "status": "EXECUTED",
          "txHash": "abababababababababababababababababababababababababababababababab",
          "executedAt": "<iso>"
        }
      }
    },
    {
      "call": "position.create",
      "args": {
        "data": {
          "marketId": "m-new",
          "tradeId": "t-22",
          "direction": "YES",
          "status": "OPEN",
          "entryPrice": 1,
          "currentPrice": 1,
          "size": 250,
          "pnl": 0,
          "sharesRaw": "1",
          "costBasisRaw": "2500000000",
          "feesPaidRaw": "25000000"
