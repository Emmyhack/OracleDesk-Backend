        }
      }
    },
    {
      "call": "position.findFirst",
      "args": {
        "where": {
          "marketId": "m-held",
          "status": "OPEN"
        }
      }
    }
  ],
  "paused": [
    {
      "call": "position.findMany",
      "args": {
        "where": {
          "status": {
            "in": [
              "CLOSED",
              "STOP_LOSS"
            ]
          },
          "closedAt": {
            "gte": "<iso>"
          }
        },
        "select": {
          "pnl": true
        }
      }
    },
    {
      "call": "pauseAgent",
      "scope": "TRADER",
      "source": "drawdown"
