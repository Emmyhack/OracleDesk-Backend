    },
    {
      "call": "$transaction",
      "ops": 2
    },
    {
      "call": "enqueueTracePublication",
      "args": {
        "traceId": "trace-1",
        "payload": {
          "traceId": "trace-1"
        },
        "action": "buy_yes"
      }
    },
    {
      "call": "agentLog.create",
      "args": {
        "data": {
          "agentType": "TRADER",
          "level": "INFO",
