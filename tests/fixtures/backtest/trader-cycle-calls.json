          },
          {
            "source": "NEWSAPI",
            "weight": 0.7,
            "signal": "headline 2",
            "rawValue": 0.4
          },
          {
            "source": "NEWSAPI",
            "weight": 0.7,
            "signal": "headline 3",
            "rawValue": 0.4
          }
